# ===== SUPABASE =====
# Wajib untuk vector search & relational queries
SUPABASE_URL=https://your-project.supabase.co
# Service role key (dipakai backend server-side)
SUPABASE_SERVICE_KEY=your-service-role-key
# Anon / publishable key (opsional, untuk client)
SUPABASE_ANON_KEY=your-anon-key

# ===== AUTH / OAUTH =====
# URL publik backend sendiri (redirect_to pada Google OAuth -> callback BE)
PUBLIC_API_URL=http://localhost:8000
# URL frontend (tujuan redirect setelah login/signup/google callback)
FRONTEND_URL=http://localhost:3000

# ===== LLM PROVIDER =====
# Pilih salah satu: OpenAI atau Gemini
# OpenAI (default untuk query expansion)
OPENAI_API_KEY=sk-your-openai-key
# Gemini fallback (REST via httpx)
GEMINI_API_KEY=your-gemini-key

# ===== ADMIN =====
# Key untuk endpoint admin (verifikasi/delete lokasi)
ADMIN_KEY=changeme

# ===== MODEL =====
# Gunakan HF_TOKEN jika model private
MODEL_NAME=indobenchmark/indobert-base-p1
HF_TOKEN=

# ===== DATA =====
DATA_PATH=../data/raw/ruangsela_DKI_bulk75_cookie_75.json